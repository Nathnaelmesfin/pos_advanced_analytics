<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Nightly target achievement and alert notifications -->
        <record id="cron_pos_analytics_target_notify" model="ir.cron">
            <field name="name">POS Analytics: Send Target Notifications</field>
            <field name="model_id" ref="pos_advanced_analytics.model_pos_analytics_service"/>
            <field name="state">code</field>
            <field name="code">model._send_target_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <!-- High refund / discount rate daily alert -->
        <record id="cron_pos_analytics_rate_alert" model="ir.cron">
            <field name="name">POS Analytics: High Refund/Discount Rate Alert</field>
            <field name="model_id" ref="pos_advanced_analytics.model_pos_analytics_service"/>
            <field name="state">code</field>
            <field name="code">model._send_rate_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
