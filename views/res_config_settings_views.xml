<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone primary form — no parent view inheritance, no xpath.
         Opened exclusively via action_pos_analytics_config which sets
         view_id to this record, so it never conflicts with the main
         Settings page. -->
    <record id="view_pos_analytics_config_form" model="ir.ui.view">
        <field name="name">pos.analytics.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form string="POS Advanced Analytics Configuration">
                <sheet>
                    <div class="oe_title">
                        <h2>POS Advanced Analytics</h2>
                        <p class="text-muted">Configure dashboard behaviour, auto-refresh, and feature toggles.</p>
                    </div>

                    <group string="Dashboard Defaults">
                        <group>
                            <field name="pos_analytics_default_period"/>
                            <field name="pos_analytics_refresh_interval"/>
                            <field name="pos_analytics_default_branch_id"/>
                            <field name="pos_analytics_timezone"/>
                        </group>
                    </group>

                    <group string="Feature Toggles">
                        <group>
                            <field name="pos_analytics_enable_targets"/>
                            <field name="pos_analytics_enable_waiter"/>
                            <field name="pos_analytics_enable_cashier"/>
                        </group>
                    </group>
                </sheet>

                <footer>
                    <button name="execute" string="Save" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
