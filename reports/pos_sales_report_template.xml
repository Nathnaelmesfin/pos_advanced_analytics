<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="pos_sales_report_template">
<t t-call="web.html_container">
<t t-call="web.external_layout">
<div class="page">

    <!-- Variables -->
    <t t-set="wiz" t-value="docs.get('wizard', {})"/>
    <t t-set="report_type" t-value="wiz.get('report_type_key', 'sales_summary')"/>
    <t t-set="include_summary" t-value="wiz.get('include_summary', True)"/>
    <t t-set="kpis" t-value="docs.get('kpis', {})"/>

    <!-- ══ REPORT HEADER ══════════════════════════════════════════════════ -->
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h2 style="color:#1F3864; border-bottom:3px solid #1F3864; padding-bottom:8px;">
                POS Advanced Analytics Report
            </h2>
            <p class="text-muted mb-0">
                <t t-esc="wiz.get('report_type', '')"/>
            </p>
        </div>
    </div>

    <!-- ══ META INFO ══════════════════════════════════════════════════════ -->
    <div class="row mb-3">
        <div class="col-6">
            <table class="table table-sm table-borderless">
                <tr>
                    <th style="width:140px;">Date Range:</th>
                    <td>
                        <t t-esc="wiz.get('date_start')"/> –
                        <t t-esc="wiz.get('date_end')"/>
                    </td>
                </tr>
                <tr>
                    <th>Branch(es):</th>
                    <td><t t-esc="wiz.get('branches', 'All Branches')"/></td>
                </tr>
                <tr>
                    <th>Report Type:</th>
                    <td><t t-esc="wiz.get('report_type', '')"/></td>
                </tr>
            </table>
        </div>
        <div class="col-6">
            <table class="table table-sm table-borderless">
                <tr>
                    <th style="width:140px;">Generated By:</th>
                    <td><t t-esc="wiz.get('generated_by', '')"/></td>
                </tr>
                <tr>
                    <th>Generated At:</th>
                    <td><t t-esc="wiz.get('generated_at', '')"/></td>
                </tr>
            </table>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════
         MANAGEMENT SUMMARY — distinct executive layout
    ═══════════════════════════════════════════════════════════════════ -->
    <t t-if="report_type == 'management_summary'">

        <!-- Executive KPI Row -->
        <h4 style="color:#1F3864; border-bottom:3px solid #1F3864; padding-bottom:6px; margin-bottom:16px;">
            Executive Performance Overview
        </h4>
        <div class="row mb-4">
            <div class="col-3">
                <div style="background:#1F3864; color:white; padding:16px; border-radius:6px; text-align:center;">
                    <div style="font-size:11px; opacity:0.8; text-transform:uppercase; letter-spacing:1px;">Total Revenue</div>
                    <div style="font-size:22px; font-weight:bold; margin-top:6px;">
                        <t t-esc="'{:,.0f}'.format(kpis.get('total_sales', 0))"/>
                    </div>
                    <div style="font-size:10px; opacity:0.7;"><t t-esc="kpis.get('currency_symbol', '')"/></div>
                </div>
            </div>
            <div class="col-3">
                <div style="background:#375623; color:white; padding:16px; border-radius:6px; text-align:center;">
                    <div style="font-size:11px; opacity:0.8; text-transform:uppercase; letter-spacing:1px;">Net Revenue</div>
                    <div style="font-size:22px; font-weight:bold; margin-top:6px;">
                        <t t-esc="'{:,.0f}'.format(kpis.get('net_sales', 0))"/>
                    </div>
                    <div style="font-size:10px; opacity:0.7;"><t t-esc="kpis.get('currency_symbol', '')"/></div>
                </div>
            </div>
            <div class="col-3">
                <div style="background:#7F6000; color:white; padding:16px; border-radius:6px; text-align:center;">
                    <div style="font-size:11px; opacity:0.8; text-transform:uppercase; letter-spacing:1px;">Total Orders</div>
                    <div style="font-size:22px; font-weight:bold; margin-top:6px;">
                        <t t-esc="'{:,}'.format(kpis.get('total_orders', 0))"/>
                    </div>
                    <div style="font-size:10px; opacity:0.7;">transactions</div>
                </div>
            </div>
            <div class="col-3">
                <div style="background:#843C0C; color:white; padding:16px; border-radius:6px; text-align:center;">
                    <div style="font-size:11px; opacity:0.8; text-transform:uppercase; letter-spacing:1px;">Avg Order Value</div>
                    <div style="font-size:22px; font-weight:bold; margin-top:6px;">
                        <t t-esc="'{:,.0f}'.format(kpis.get('avg_order_value', 0))"/>
                    </div>
                    <div style="font-size:10px; opacity:0.7;"><t t-esc="kpis.get('currency_symbol', '')"/></div>
                </div>
            </div>
        </div>

        <!-- Risk / Operational Indicators -->
        <div class="row mb-4">
            <div class="col-12">
                <h5 style="color:#1F3864; margin-bottom:8px;">Operational Indicators</h5>
                <table class="table table-sm table-bordered" style="font-size:12px;">
                    <thead style="background:#2E75B6; color:white;">
                        <tr>
                            <th>Indicator</th>
                            <th class="text-right">Value</th>
                            <th class="text-right">Sessions</th>
                            <th class="text-right">Avg Items/Order</th>
                            <th class="text-right">Change Returned</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Refund Rate</strong></td>
                            <td class="text-right">
                                <t t-esc="'{:.2f}'.format(kpis.get('refund_rate', 0))"/>%
                            </td>
                            <td class="text-right" rowspan="2">
                                <t t-esc="kpis.get('total_sessions', 0)"/>
                            </td>
                            <td class="text-right" rowspan="2">
                                <t t-esc="'{:.2f}'.format(kpis.get('avg_items_per_order', 0))"/>
                            </td>
                            <td class="text-right" rowspan="2">
                                <t t-esc="'{:,.2f}'.format(kpis.get('total_change_returned', 0))"/>
                            </td>
                            <td>
                                <t t-if="kpis.get('refund_rate', 0) > 10">
                                    <span style="color:#C00000; font-weight:bold;">&#9888; High</span>
                                </t>
                                <t t-elif="kpis.get('refund_rate', 0) > 5">
                                    <span style="color:#FFC000; font-weight:bold;">&#9888; Monitor</span>
                                </t>
                                <t t-else="">
                                    <span style="color:#375623; font-weight:bold;">&#10003; Normal</span>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Discount Rate</strong></td>
                            <td class="text-right">
                                <t t-esc="'{:.2f}'.format(kpis.get('discount_rate', 0))"/>%
                            </td>
                            <td>
                                <t t-if="kpis.get('discount_rate', 0) > 20">
                                    <span style="color:#C00000; font-weight:bold;">&#9888; High</span>
                                </t>
                                <t t-elif="kpis.get('discount_rate', 0) > 10">
                                    <span style="color:#FFC000; font-weight:bold;">&#9888; Monitor</span>
                                </t>
                                <t t-else="">
                                    <span style="color:#375623; font-weight:bold;">&#10003; Normal</span>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Top Performers -->
        <div class="row mb-4">
            <div class="col-6">
                <h5 style="color:#1F3864; margin-bottom:8px;">Top Performers</h5>
                <table class="table table-sm table-bordered" style="font-size:12px;">
                    <tr><th style="width:160px;">Best Product</th>
                        <td><t t-esc="kpis.get('best_selling_product') or '—'"/></td></tr>
                    <tr><th>Best Category</th>
                        <td><t t-esc="kpis.get('best_selling_category') or '—'"/></td></tr>
                    <tr><th>Top Waiter</th>
                        <td><t t-esc="kpis.get('top_waiter') or '—'"/></td></tr>
                    <tr><th>Top Cashier</th>
                        <td><t t-esc="kpis.get('top_cashier') or '—'"/></td></tr>
                    <tr><th>Peak Hour</th>
                        <td>
                            <t t-if="kpis.get('peak_hour') is not None">
                                <t t-esc="'%02d:00' % kpis.get('peak_hour')"/>
                            </t>
                            <t t-else="">—</t>
                        </td>
                    </tr>
                    <tr><th>Peak Day</th>
                        <td><t t-esc="kpis.get('peak_day') or '—'"/></td></tr>
                </table>
            </div>
            <div class="col-6">
                <h5 style="color:#1F3864; margin-bottom:8px;">Payment Breakdown</h5>
                <table class="table table-sm table-bordered" style="font-size:12px;">
                    <tr><th style="width:160px;">Cash</th>
                        <td class="text-right"><t t-esc="'{:,.2f}'.format(kpis.get('cash_sales', 0))"/></td></tr>
                    <tr><th>Bank / Card</th>
                        <td class="text-right"><t t-esc="'{:,.2f}'.format(kpis.get('bank_card_sales', 0))"/></td></tr>
                    <tr><th>Mobile Money</th>
                        <td class="text-right"><t t-esc="'{:,.2f}'.format(kpis.get('mobile_money_sales', 0))"/></td></tr>
                    <tr><th>Other</th>
                        <td class="text-right"><t t-esc="'{:,.2f}'.format(kpis.get('other_payment_sales', 0))"/></td></tr>
                    <tr><th>Total Tax</th>
                        <td class="text-right"><t t-esc="'{:,.2f}'.format(kpis.get('total_tax', 0))"/></td></tr>
                    <tr><th>Total Discounts</th>
                        <td class="text-right"><t t-esc="'{:,.2f}'.format(kpis.get('total_discounts', 0))"/></td></tr>
                </table>
            </div>
        </div>

        <!-- Branch Comparison (exec view) -->
        <t t-set="branches_exec" t-value="docs.get('branch_comparison', [])"/>
        <t t-if="branches_exec">
            <h5 style="color:#1F3864; margin-bottom:8px;">Branch Performance</h5>
            <table class="table table-sm table-bordered mb-4" style="font-size:11px;">
                <thead style="background:#1F3864; color:white;">
                    <tr>
                        <th>Branch</th>
                        <th class="text-right">Revenue</th>
                        <th class="text-right">Net Revenue</th>
                        <th class="text-right">Orders</th>
                        <th class="text-right">Avg Order</th>
                        <th class="text-right">Refunds</th>
                        <th>Top Product</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="branches_exec" t-as="b">
                        <tr>
                            <td><strong><t t-esc="b.get('branch_name', '')"/></strong></td>
                            <td class="text-right"><t t-esc="'{:,.2f}'.format(b.get('total_sales', 0))"/></td>
                            <td class="text-right"><t t-esc="'{:,.2f}'.format(b.get('net_sales', 0))"/></td>
                            <td class="text-right"><t t-esc="b.get('total_orders', 0)"/></td>
                            <td class="text-right"><t t-esc="'{:,.2f}'.format(b.get('avg_order_value', 0))"/></td>
                            <td class="text-right"><t t-esc="'{:,.2f}'.format(b.get('total_refunds', 0))"/></td>
                            <td><t t-esc="b.get('top_product') or '—'"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </t>

    </t>

    <!-- ══════════════════════════════════════════════════════════════════
         ALL OTHER REPORT TYPES
    ═══════════════════════════════════════════════════════════════════ -->
    <t t-if="report_type != 'management_summary'">

        <!-- ── KPI CARDS (include_summary=True) ──────────────────────────── -->
        <t t-if="include_summary">
            <h4 style="color:#1F3864; border-bottom:2px solid #BDD7EE; padding-bottom:4px;">
                Key Performance Indicators
            </h4>
            <div class="row mb-3">
                <div class="col-3 mb-2">
                    <div style="background:#EBF3FB; border-left:4px solid #2E75B6; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Total Sales</div>
                        <div style="font-size:16px; font-weight:bold; color:#1F3864;">
                            <t t-esc="'{:,.2f}'.format(kpis.get('total_sales', 0))"/>
                            <small> <t t-esc="kpis.get('currency_symbol', '')"/></small>
                        </div>
                    </div>
                </div>
                <div class="col-3 mb-2">
                    <div style="background:#E2EFDA; border-left:4px solid #70AD47; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Net Sales</div>
                        <div style="font-size:16px; font-weight:bold; color:#375623;">
                            <t t-esc="'{:,.2f}'.format(kpis.get('net_sales', 0))"/>
                            <small> <t t-esc="kpis.get('currency_symbol', '')"/></small>
                        </div>
                    </div>
                </div>
                <div class="col-3 mb-2">
                    <div style="background:#FFF2CC; border-left:4px solid #FFC000; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Total Orders</div>
                        <div style="font-size:16px; font-weight:bold; color:#7F6000;">
                            <t t-esc="kpis.get('total_orders', 0)"/>
                        </div>
                    </div>
                </div>
                <div class="col-3 mb-2">
                    <div style="background:#FCE4D6; border-left:4px solid #ED7D31; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Avg Order Value</div>
                        <div style="font-size:16px; font-weight:bold; color:#843C0C;">
                            <t t-esc="'{:,.2f}'.format(kpis.get('avg_order_value', 0))"/>
                            <small> <t t-esc="kpis.get('currency_symbol', '')"/></small>
                        </div>
                    </div>
                </div>
                <div class="col-3 mb-2">
                    <div style="background:#EBF3FB; border-left:4px solid #2E75B6; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Total Tax</div>
                        <div style="font-size:14px; font-weight:bold; color:#1F3864;">
                            <t t-esc="'{:,.2f}'.format(kpis.get('total_tax', 0))"/>
                        </div>
                    </div>
                </div>
                <div class="col-3 mb-2">
                    <div style="background:#FCE4D6; border-left:4px solid #ED7D31; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Total Discounts</div>
                        <div style="font-size:14px; font-weight:bold; color:#843C0C;">
                            <t t-esc="'{:,.2f}'.format(kpis.get('total_discounts', 0))"/>
                        </div>
                    </div>
                </div>
                <div class="col-3 mb-2">
                    <div style="background:#FCE4D6; border-left:4px solid #C00000; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Total Refunds</div>
                        <div style="font-size:14px; font-weight:bold; color:#C00000;">
                            <t t-esc="'{:,.2f}'.format(kpis.get('total_refunds', 0))"/>
                        </div>
                    </div>
                </div>
                <div class="col-3 mb-2">
                    <div style="background:#E2EFDA; border-left:4px solid #70AD47; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Qty Sold</div>
                        <div style="font-size:14px; font-weight:bold; color:#375623;">
                            <t t-esc="'{:,.2f}'.format(kpis.get('total_qty_sold', 0))"/>
                        </div>
                    </div>
                </div>
                <!-- 5 new KPI cards -->
                <div class="col-3 mb-2">
                    <div style="background:#FFF2CC; border-left:4px solid #FFC000; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Refund Rate</div>
                        <div style="font-size:14px; font-weight:bold; color:#7F6000;">
                            <t t-esc="'{:.2f}'.format(kpis.get('refund_rate', 0))"/>%
                        </div>
                    </div>
                </div>
                <div class="col-3 mb-2">
                    <div style="background:#FFF2CC; border-left:4px solid #ED7D31; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Discount Rate</div>
                        <div style="font-size:14px; font-weight:bold; color:#843C0C;">
                            <t t-esc="'{:.2f}'.format(kpis.get('discount_rate', 0))"/>%
                        </div>
                    </div>
                </div>
                <div class="col-3 mb-2">
                    <div style="background:#EBF3FB; border-left:4px solid #2E75B6; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Total Sessions</div>
                        <div style="font-size:14px; font-weight:bold; color:#1F3864;">
                            <t t-esc="kpis.get('total_sessions', 0)"/>
                        </div>
                    </div>
                </div>
                <div class="col-3 mb-2">
                    <div style="background:#E2EFDA; border-left:4px solid #70AD47; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Avg Items / Order</div>
                        <div style="font-size:14px; font-weight:bold; color:#375623;">
                            <t t-esc="'{:.2f}'.format(kpis.get('avg_items_per_order', 0))"/>
                        </div>
                    </div>
                </div>
                <div class="col-3 mb-2">
                    <div style="background:#EBF3FB; border-left:4px solid #4472C4; padding:10px; border-radius:4px;">
                        <div style="font-size:11px; color:#666;">Change Returned</div>
                        <div style="font-size:14px; font-weight:bold; color:#1F3864;">
                            <t t-esc="'{:,.2f}'.format(kpis.get('total_change_returned', 0))"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Highlights row -->
            <div class="row mb-4">
                <div class="col-12">
                    <table class="table table-sm table-bordered" style="font-size:12px;">
                        <thead style="background:#1F3864; color:white;">
                            <tr>
                                <th>Cash Sales</th>
                                <th>Bank/Card</th>
                                <th>Mobile Money</th>
                                <th>Best Product</th>
                                <th>Best Category</th>
                                <th>Top Waiter</th>
                                <th>Top Cashier</th>
                                <th>Peak Hour</th>
                                <th>Peak Day</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><t t-esc="'{:,.2f}'.format(kpis.get('cash_sales', 0))"/></td>
                                <td><t t-esc="'{:,.2f}'.format(kpis.get('bank_card_sales', 0))"/></td>
                                <td><t t-esc="'{:,.2f}'.format(kpis.get('mobile_money_sales', 0))"/></td>
                                <td><t t-esc="kpis.get('best_selling_product') or '—'"/></td>
                                <td><t t-esc="kpis.get('best_selling_category') or '—'"/></td>
                                <td><t t-esc="kpis.get('top_waiter') or '—'"/></td>
                                <td><t t-esc="kpis.get('top_cashier') or '—'"/></td>
                                <td>
                                    <t t-if="kpis.get('peak_hour') is not None">
                                        <t t-esc="'%02d:00' % kpis.get('peak_hour')"/>
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                                <td><t t-esc="kpis.get('peak_day') or '—'"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t><!-- end include_summary -->

        <!-- ── TYPE-SPECIFIC SECTIONS ────────────────────────────────────── -->

        <!-- SALES SUMMARY / DAILY SALES: sales trend table -->
        <t t-if="report_type in ('sales_summary', 'daily_sales', 'hourly_sales')">
            <t t-set="trend" t-value="docs.get('sales_trend', [])"/>
            <t t-if="trend">
                <h4 style="color:#1F3864; border-bottom:2px solid #BDD7EE; padding-bottom:4px;">
                    Sales Trend
                </h4>
                <table class="table table-sm table-bordered mb-4" style="font-size:11px;">
                    <thead style="background:#2E75B6; color:white;">
                        <tr>
                            <th>Period</th>
                            <th class="text-right">Total Sales</th>
                            <th class="text-right">Refunds</th>
                            <th class="text-right">Net Sales</th>
                            <th class="text-right">Orders</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="trend" t-as="row">
                            <tr>
                                <td><t t-esc="row.get('label', '')"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(row.get('total_sales', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(row.get('total_refunds', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(row.get('net_sales', 0))"/></td>
                                <td class="text-right"><t t-esc="row.get('order_count', 0)"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>

        <!-- PRODUCT SALES -->
        <t t-if="report_type in ('product_sales', 'sales_summary')">
            <t t-set="products" t-value="docs.get('top_products', [])"/>
            <t t-if="products">
                <h4 style="color:#1F3864; border-bottom:2px solid #BDD7EE; padding-bottom:4px;">
                    Top Products
                </h4>
                <table class="table table-sm table-bordered mb-4" style="font-size:11px;">
                    <thead style="background:#2E75B6; color:white;">
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th class="text-right">Qty Sold</th>
                            <th class="text-right">Gross Sales</th>
                            <th class="text-right">Discount</th>
                            <th class="text-right">Net Sales</th>
                            <th class="text-right">Refund Qty</th>
                            <th class="text-right">Refund Amt</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="products" t-as="p">
                            <tr>
                                <td><t t-esc="p.get('product_name', '')"/></td>
                                <td><t t-esc="p.get('categ_name', '')"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(p.get('qty_sold', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(p.get('gross_sales', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(p.get('discount_amount', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(p.get('net_sales', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(p.get('refund_qty', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(p.get('refund_amount', 0))"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>

        <!-- CATEGORY SALES -->
        <t t-if="report_type in ('category_sales', 'sales_summary')">
            <t t-set="categories" t-value="docs.get('top_categories', [])"/>
            <t t-if="categories">
                <h4 style="color:#1F3864; border-bottom:2px solid #BDD7EE; padding-bottom:4px;">
                    Sales by Category
                </h4>
                <table class="table table-sm table-bordered mb-4" style="font-size:11px;">
                    <thead style="background:#2E75B6; color:white;">
                        <tr>
                            <th>Category</th>
                            <th class="text-right">Qty Sold</th>
                            <th class="text-right">Gross Sales</th>
                            <th class="text-right">Discount</th>
                            <th class="text-right">Net Sales</th>
                            <th class="text-right">Refund Qty</th>
                            <th class="text-right">Refund Amt</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="categories" t-as="c">
                            <tr>
                                <td><t t-esc="c.get('categ_name', '')"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(c.get('qty_sold', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(c.get('gross_sales', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(c.get('discount_amount', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(c.get('net_sales', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(c.get('refund_qty', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(c.get('refund_amount', 0))"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>

        <!-- WAITER PERFORMANCE -->
        <t t-if="report_type in ('waiter_performance', 'sales_summary')">
            <t t-set="waiters" t-value="docs.get('waiter_performance', [])"/>
            <t t-if="waiters">
                <h4 style="color:#1F3864; border-bottom:2px solid #BDD7EE; padding-bottom:4px;">
                    Waiter Performance
                </h4>
                <table class="table table-sm table-bordered mb-4" style="font-size:11px;">
                    <thead style="background:#2E75B6; color:white;">
                        <tr>
                            <th>Waiter</th>
                            <th class="text-right">Total Sales</th>
                            <th class="text-right">Orders</th>
                            <th class="text-right">Avg Order</th>
                            <th class="text-right">Qty Sold</th>
                            <th class="text-right">Refunds</th>
                            <th class="text-right">Discounts</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="waiters" t-as="w">
                            <tr>
                                <td><t t-esc="w.get('waiter_name', '')"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(w.get('total_sales', 0))"/></td>
                                <td class="text-right"><t t-esc="w.get('total_orders', 0)"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(w.get('avg_order_value', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(w.get('qty_sold', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(w.get('total_refunds', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(w.get('total_discounts', 0))"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>

        <!-- CASHIER PERFORMANCE -->
        <t t-if="report_type in ('cashier_performance', 'sales_summary')">
            <t t-set="cashiers" t-value="docs.get('cashier_performance', [])"/>
            <t t-if="cashiers">
                <h4 style="color:#1F3864; border-bottom:2px solid #BDD7EE; padding-bottom:4px;">
                    Cashier Performance
                </h4>
                <table class="table table-sm table-bordered mb-4" style="font-size:11px;">
                    <thead style="background:#2E75B6; color:white;">
                        <tr>
                            <th>Cashier</th>
                            <th class="text-right">Collected</th>
                            <th class="text-right">Orders</th>
                            <th class="text-right">Avg Ticket</th>
                            <th class="text-right">Refunds</th>
                            <th class="text-right">Discounts</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="cashiers" t-as="c">
                            <tr>
                                <td><t t-esc="c.get('cashier_name', '')"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(c.get('total_collected', 0))"/></td>
                                <td class="text-right"><t t-esc="c.get('total_orders', 0)"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(c.get('avg_ticket', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(c.get('total_refunds', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(c.get('total_discounts', 0))"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>

        <!-- PAYMENT METHOD -->
        <t t-if="report_type in ('payment_method', 'sales_summary')">
            <t t-set="payments" t-value="docs.get('payment_methods', [])"/>
            <t t-if="payments">
                <h4 style="color:#1F3864; border-bottom:2px solid #BDD7EE; padding-bottom:4px;">
                    Payment Method Breakdown
                </h4>
                <table class="table table-sm table-bordered mb-4" style="font-size:11px;">
                    <thead style="background:#2E75B6; color:white;">
                        <tr>
                            <th>Payment Method</th>
                            <th class="text-right">Total Amount</th>
                            <th class="text-right">Order Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="payments" t-as="pm">
                            <tr>
                                <td><t t-esc="pm.get('method_name', '')"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(pm.get('total_amount', 0))"/></td>
                                <td class="text-right"><t t-esc="pm.get('order_count', 0)"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>

        <!-- HOURLY SALES -->
        <t t-if="report_type in ('hourly_sales', 'sales_summary')">
            <t t-set="peak_hours" t-value="docs.get('peak_hours', [])"/>
            <t t-if="peak_hours">
                <h4 style="color:#1F3864; border-bottom:2px solid #BDD7EE; padding-bottom:4px;">
                    Peak Hours Analysis
                </h4>
                <table class="table table-sm table-bordered mb-4" style="font-size:11px;">
                    <thead style="background:#2E75B6; color:white;">
                        <tr>
                            <th>Hour</th>
                            <th class="text-right">Orders</th>
                            <th class="text-right">Total Sales</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="peak_hours" t-as="h">
                            <tr>
                                <td><t t-esc="h.get('label', '')"/></td>
                                <td class="text-right"><t t-esc="h.get('order_count', 0)"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(h.get('total_sales', 0))"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>

        <!-- REFUND & DISCOUNT -->
        <t t-if="report_type in ('refund_discount', 'sales_summary')">
            <t t-set="rds" t-value="docs.get('refund_discount_summary', {})"/>
            <t t-if="rds">
                <h4 style="color:#1F3864; border-bottom:2px solid #BDD7EE; padding-bottom:4px;">
                    Refund &amp; Discount Summary
                </h4>
                <div class="row mb-4">
                    <div class="col-6">
                        <table class="table table-sm table-bordered" style="font-size:11px;">
                            <tr><th>Total Refund Amount</th>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(rds.get('total_refund_amount', 0))"/></td></tr>
                            <tr><th>Refund Orders</th>
                                <td class="text-right"><t t-esc="rds.get('refund_order_count', 0)"/></td></tr>
                            <tr><th>Total Discount Amount</th>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(rds.get('total_discount_amount', 0))"/></td></tr>
                            <tr><th>Discounted Orders</th>
                                <td class="text-right"><t t-esc="rds.get('discounted_order_count', 0)"/></td></tr>
                        </table>
                    </div>
                </div>
            </t>
        </t>

        <!-- TAX REPORT -->
        <t t-if="report_type == 'tax_report'">
            <h4 style="color:#1F3864; border-bottom:2px solid #BDD7EE; padding-bottom:4px;">
                Tax Summary
            </h4>
            <table class="table table-sm table-bordered mb-4" style="font-size:11px; max-width:400px;">
                <tr><th style="width:220px;">Total Sales (incl. tax)</th>
                    <td class="text-right"><t t-esc="'{:,.2f}'.format(kpis.get('total_sales', 0))"/></td></tr>
                <tr><th>Total Tax Amount</th>
                    <td class="text-right"><t t-esc="'{:,.2f}'.format(kpis.get('total_tax', 0))"/></td></tr>
                <tr><th>Net Sales (excl. tax)</th>
                    <td class="text-right">
                        <t t-esc="'{:,.2f}'.format(kpis.get('total_sales', 0) - kpis.get('total_tax', 0))"/>
                    </td>
                </tr>
            </table>
        </t>

        <!-- BRANCH COMPARISON -->
        <t t-if="report_type in ('branch_comparison', 'sales_summary')">
            <t t-set="branches" t-value="docs.get('branch_comparison', [])"/>
            <t t-if="branches and len(branches) > 1">
                <h4 style="color:#1F3864; border-bottom:2px solid #BDD7EE; padding-bottom:4px;">
                    Branch Comparison
                </h4>
                <table class="table table-sm table-bordered mb-4" style="font-size:11px;">
                    <thead style="background:#2E75B6; color:white;">
                        <tr>
                            <th>Branch</th>
                            <th class="text-right">Total Sales</th>
                            <th class="text-right">Net Sales</th>
                            <th class="text-right">Orders</th>
                            <th class="text-right">Avg Order</th>
                            <th>Top Product</th>
                            <th>Peak Hour</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="branches" t-as="b">
                            <tr>
                                <td><t t-esc="b.get('branch_name', '')"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(b.get('total_sales', 0))"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(b.get('net_sales', 0))"/></td>
                                <td class="text-right"><t t-esc="b.get('total_orders', 0)"/></td>
                                <td class="text-right"><t t-esc="'{:,.2f}'.format(b.get('avg_order_value', 0))"/></td>
                                <td><t t-esc="b.get('top_product') or '—'"/></td>
                                <td>
                                    <t t-if="b.get('peak_hour') is not None">
                                        <t t-esc="'%02d:00' % b.get('peak_hour')"/>
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>

        <!-- DAILY CLOSING -->
        <t t-if="report_type == 'daily_closing'">
            <t t-set="closing" t-value="docs.get('closing_data', [])"/>
            <t t-if="closing">
                <div style="page-break-before:always;"/>
                <h4 style="color:#1F3864; border-bottom:2px solid #BDD7EE; padding-bottom:4px;">
                    Daily Closing / Session Report
                </h4>
                <t t-foreach="closing" t-as="s">
                    <div class="mb-3" style="border:1px solid #BDD7EE; border-radius:4px; padding:10px;">
                        <div class="row mb-2">
                            <div class="col-6">
                                <strong>Session:</strong> <t t-esc="s.get('session_name', '')"/><br/>
                                <strong>Branch:</strong> <t t-esc="s.get('branch_name', '')"/><br/>
                                <strong>Cashier:</strong> <t t-esc="s.get('cashier_name', '')"/><br/>
                                <strong>State:</strong> <t t-esc="s.get('session_state', '')"/>
                            </div>
                            <div class="col-6">
                                <strong>Opening:</strong> <t t-esc="s.get('opening_time', '') or '—'"/><br/>
                                <strong>Closing:</strong> <t t-esc="s.get('closing_time', '') or '—'"/>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered" style="font-size:11px;">
                            <tr>
                                <th>Total Sales</th><td><t t-esc="'{:,.2f}'.format(s.get('total_sales', 0))"/></td>
                                <th>Net Sales</th><td><t t-esc="'{:,.2f}'.format(s.get('net_sales', 0))"/></td>
                                <th>Orders</th><td><t t-esc="s.get('total_orders', 0)"/></td>
                            </tr>
                            <tr>
                                <th>Tax</th><td><t t-esc="'{:,.2f}'.format(s.get('total_tax', 0))"/></td>
                                <th>Refunds</th><td><t t-esc="'{:,.2f}'.format(s.get('total_refunds', 0))"/></td>
                                <th>Discounts</th><td><t t-esc="'{:,.2f}'.format(s.get('total_discounts', 0))"/></td>
                            </tr>
                            <tr>
                                <th>Avg Order</th><td><t t-esc="'{:,.2f}'.format(s.get('avg_order_value', 0))"/></td>
                                <th>Change Returned</th><td colspan="3"><t t-esc="'{:,.2f}'.format(s.get('total_change_returned', 0))"/></td>
                            </tr>
                        </table>
                        <t t-if="s.get('payment_methods')">
                            <strong>Payment Methods:</strong>
                            <span t-foreach="s.get('payment_methods', [])" t-as="pm">
                                <t t-esc="pm.get('method', '')"/>: <t t-esc="'{:,.2f}'.format(pm.get('amount', 0))"/>
                                <t t-if="not pm_last"> | </t>
                            </span>
                        </t>
                    </div>
                </t>
            </t>
        </t>

    </t><!-- end non-management types -->

    <!-- ══════════════════════════════════════════════════════════════════
         RAW ORDERS ANNEX — rendered when include_raw_orders=True on any
         report type other than daily_closing (which shows sessions inline).
    ═══════════════════════════════════════════════════════════════════ -->
    <t t-set="raw_closing" t-value="docs.get('closing_data', [])"/>
    <t t-if="report_type != 'daily_closing' and raw_closing and wiz.get('include_raw_orders', False)">
        <div style="page-break-before:always;"/>
        <h4 style="color:#1F3864; border-bottom:3px solid #1F3864; padding-bottom:6px; margin-bottom:16px;">
            Raw POS Sessions / Closing Data
        </h4>
        <t t-foreach="raw_closing" t-as="s">
            <div class="mb-3" style="border:1px solid #BDD7EE; border-radius:4px; padding:10px;">
                <div class="row mb-2">
                    <div class="col-6">
                        <strong>Session:</strong> <t t-esc="s.get('session_name', '')"/><br/>
                        <strong>Branch:</strong> <t t-esc="s.get('branch_name', '')"/><br/>
                        <strong>Cashier:</strong> <t t-esc="s.get('cashier_name', '')"/><br/>
                        <strong>State:</strong>
                        <span t-att-style="'color:' + ('green' if s.get('session_state') == 'opened' else '#555') + '; font-weight:bold;'">
                            <t t-esc="(s.get('session_state') or '').replace('_', ' ').title()"/>
                        </span>
                    </div>
                    <div class="col-6">
                        <strong>Opening:</strong> <t t-esc="s.get('opening_time', '') or '—'"/><br/>
                        <strong>Closing:</strong> <t t-esc="s.get('closing_time', '') or '—'"/>
                    </div>
                </div>
                <table class="table table-sm table-bordered" style="font-size:11px;">
                    <tr>
                        <th style="width:120px;">Total Sales</th>
                        <td><t t-esc="'{:,.2f}'.format(s.get('total_sales', 0))"/></td>
                        <th style="width:120px;">Net Sales</th>
                        <td><t t-esc="'{:,.2f}'.format(s.get('net_sales', 0))"/></td>
                        <th style="width:80px;">Orders</th>
                        <td><t t-esc="s.get('total_orders', 0)"/></td>
                    </tr>
                    <tr>
                        <th>Tax</th>
                        <td><t t-esc="'{:,.2f}'.format(s.get('total_tax', 0))"/></td>
                        <th>Refunds</th>
                        <td><t t-esc="'{:,.2f}'.format(s.get('total_refunds', 0))"/></td>
                        <th>Discounts</th>
                        <td><t t-esc="'{:,.2f}'.format(s.get('total_discounts', 0))"/></td>
                    </tr>
                    <tr>
                        <th>Avg Order</th>
                        <td><t t-esc="'{:,.2f}'.format(s.get('avg_order_value', 0))"/></td>
                        <th>Change Returned</th>
                        <td colspan="3"><t t-esc="'{:,.2f}'.format(s.get('total_change_returned', 0))"/></td>
                    </tr>
                </table>
                <t t-if="s.get('payment_methods')">
                    <strong>Payment Methods:</strong>
                    <span t-foreach="s.get('payment_methods', [])" t-as="pm">
                        <t t-esc="pm.get('method', '')"/>: <t t-esc="'{:,.2f}'.format(pm.get('amount', 0))"/>
                        <t t-if="not pm_last"> | </t>
                    </span>
                </t>
            </div>
        </t>
    </t>

    <!-- ══ FOOTER NOTE ══════════════════════════════════════════════════════ -->
    <div class="row mt-4">
        <div class="col-12 text-muted" style="font-size:10px; border-top:1px solid #ddd; padding-top:8px;">
            Generated by POS Advanced Analytics.
            All figures in <t t-esc="kpis.get('currency_symbol', '')"/>.
            Timezone: Africa/Addis_Ababa.
            Report excludes cost, profit, margin, and inventory data.
        </div>
    </div>

</div>
</t>
</t>
</template>
</odoo>
